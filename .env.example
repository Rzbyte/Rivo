# Rivo configuration. Copy to `.env` — which is gitignored — and edit.
#
# Every read-only command works with this file absent: calibrate, scan, allocate,
# backtest, diagnose, band, maker, report, and the entire dry-run runtime read
# public indexers and need no credentials at all.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
NETWORK=testnet

# The DreamDEX venue. One deployment hosts several venues and their markets sit
# side by side in the indexer, so this must be set explicitly.
#
# THESE MOVE. Both networks changed venue three times in the first week of
# August 2026. If Rivo reports no live markets, read venueId off a live market
# row rather than trusting this value.
#   testnet  0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
#   mainnet  0x458b30c2d72bfd2c6317304a4594ecbafe5f729d3111b65fdc3a33bd48e5432d
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Collateral decimals: 6 on testnet (tUSDC), 18 on mainnet (USDso). Derived from
# NETWORK; override only if a venue changes.
# DECIMALS=6

# ---------------------------------------------------------------------------
# Endpoint overrides — defaults are built in per network
# ---------------------------------------------------------------------------
# RIVO_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# RIVO_PRICE_FEED_URL=https://price-feed.dev.oracle.somnia.host/v1/graphql
#
# Mainnet has no bundled price feed. Set RIVO_PRICE_FEED_URL there or the
# fair-value model has no underlying to price against.

# ---------------------------------------------------------------------------
# Live trading — everything below is OPTIONAL
# ---------------------------------------------------------------------------
# Dry run is the default and matches every strategy in the official kit. Live
# trading requires BOTH a funded key and DRY_RUN=false; either alone stays dry.
DRY_RUN=true

# THE KEY RIVO SIGNS WITH — prefer an agent wallet over this file.
#
#   npm run agent -- new                            # generates .rivo/agent.key
#   npm run agent -- fund --collateral 25 --gas 1   # moves a float in, from PRIVATE_KEY
#   npm run agent -- sweep                          # takes it all back
#
# An agent wallet holds only its float, so a compromised machine costs you that
# float rather than everything the wallet below has ever held. Rivo prefers it
# automatically whenever the key file exists. The venue offers nothing stronger:
# on-chain scoping for Event Contracts is present in the deployed contract and
# disabled — see docs/SDK-FEEDBACK.md §9, or run `npm run probe:operator`.
#
# PRIVATE_KEY is still needed to FUND and SWEEP the agent, and is used directly
# when no agent wallet exists. A funded testnet signer needs STT for gas and
# tUSDC for collateral, both from the faucet. Placeholders like `0x...` are
# rejected — Rivo checks for a real 32-byte key and stays dry otherwise.
# PRIVATE_KEY=

# Where the agent wallet's key lives. Mounted read-only in the container image.
# RIVO_AGENT_KEY_FILE=./.rivo/agent.key

# Force the raw key above even when an agent wallet exists. Only set this if you
# genuinely mean to trade your own wallet.
# RIVO_AUTHORITY=env

# Required before the cockpit may bind anywhere but loopback, because its control
# endpoints can start live trading with the key above. It refuses without one.
# RIVO_CONTROL_TOKEN=

# The live executor loads `@dreamdex-bot-kit/ec-core` on demand. Point this
# elsewhere if the kit is installed under a different specifier or path.
# RIVO_EC_CORE=@dreamdex-bot-kit/ec-core

# Where state and the decision log are written.
# RIVO_DATA_DIR=./data

# WHERE TO SHOUT WHEN IT STOPS.
#
# An unattended trader that halts at 3am and tells nobody has done half its job:
# the capital is protected and the operator still believes it is trading. Both
# canary runs ended with the drawdown breaker firing and both were found the next
# day, by reading a log.
#
# A generic JSON webhook — Slack and Discord incoming webhooks both work, and the
# body carries the key each expects. Telegram is separate because its API takes a
# chat id. Set either, or both, or neither: with none configured the runtime says
# so at startup and stays quiet.
# RIVO_ALERT_WEBHOOK=https://hooks.slack.com/services/...
# RIVO_ALERT_TELEGRAM_TOKEN=
# RIVO_ALERT_TELEGRAM_CHAT=

# Roll the decision log at this size, keeping one previous generation. The log is
# the forward-test record and grows ~7MB a day at a 45s cadence; a trading
# process that dies of a full disk dies holding positions. Set 0 to keep
# everything and watch the disk yourself.
# RIVO_LOG_MAX_BYTES=67108864
