# Dependencies
node_modules/

# Runtime state — a portfolio and its decision log are per-deployment, never shared.
# Committing these would also publish a trading history that says nothing about the
# code and everything about one machine's uptime.
data/
data*/

# Logs
*.log

# Scratch probes
tmp/

# Public page build output. index.html and the source are tracked; the bundle,
# the copied evidence and the self-contained file are all regenerated by
# `npm run build:public`, so committing them would only create merge noise.
public/app.js
public/calibration.json
public/rivo-public.html

# Generated dashboard snapshots. One curated copy lives in docs/evidence/.
rivo-dashboard.html

# Reports written by the CLIs with --out. Curated copies live in docs/evidence/.
/calibration.json
/backtest.json

# The agent wallet's key. Same rule as .env, and more important: this one is
# generated rather than pasted, so nobody consciously decides where it goes.
.rivo/

# Secrets. There is no reason a key belongs in this repo, ever.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
