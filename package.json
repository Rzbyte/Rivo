{
  "name": "rivo",
  "version": "0.1.0",
  "description": "Event intelligence and agent validation for DreamDEX Event Contracts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rzbyte/Rivo.git"
  },
  "homepage": "https://x-rivo.vercel.app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "calibrate": "tsx src/calibration/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.public.json && npm --workspace @rivo/web run typecheck",
    "scan": "tsx src/cli/scan.ts",
    "allocate": "tsx src/cli/allocate.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "diagnose": "tsx src/cli/diagnose.ts",
    "concentration": "tsx src/cli/concentration.ts",
    "band": "tsx src/cli/band.ts",
    "maker": "tsx src/cli/maker.ts",
    "start": "tsx src/cli/run.ts",
    "dev": "tsx watch src/cli/run.ts",
    "report": "tsx src/cli/report.ts",
    "web": "tsx src/cli/web.ts",
    "check:kit": "tsx scripts/check-kit.ts",
    "link:kit": "npm install --no-save file:../dreamdex-bot-kit/packages/ec-core",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx scripts/doctor.ts",
    "faucet": "tsx scripts/faucet.ts",
    "approve": "tsx scripts/approve.ts",
    "coherence": "tsx src/cli/coherence.ts",
    "maker:live": "tsx src/cli/makerlive.ts",
    "build:public": "tsx scripts/build-public.ts",
    "proof": "tsx src/cli/proof.ts",
    "probe:operator": "tsx scripts/probe-operator.ts",
    "agent": "tsx src/cli/agent.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "dev:pg": "tsx scripts/dev-postgres.ts",
    "worker": "tsx src/cli/worker.ts",
    "build:web": "npm --workspace @rivo/web run build",
    "dev:web": "npm --workspace @rivo/web run dev",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "privy:check": "tsx scripts/privy-check.ts",
    "alpha": "tsx src/cli/alpha.ts",
    "testcount": "tsx scripts/testcount.ts",
    "calibration": "tsx src/cli/calibration.ts",
    "shadow": "tsx src/cli/shadow.ts",
    "final-proof": "tsx src/cli/finalproof.ts",
    "release": "tsx src/cli/release.ts",
    "seed:agents": "tsx scripts/seed-agents.ts",
    "breadth": "tsx src/cli/breadth.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "happy-dom": "^20.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@privy-io/server-auth": "^1.32.5",
    "pg": "^8.23.0",
    "viem": "^2.55.19"
  },
  "workspaces": [
    "web"
  ],
  "overrides": {
    "ws": "^8.21.3",
    "axios": "^1.19.0",
    "uuid": "^11.1.1"
  }
}
